programa
{
	
	funcao inicio()
	{
	real nota1 = 6
	real nota2 = 8 
	real nota3 = 9
	real nota4 = 8

	real media 

	media = (nota1 + nota2 + nota3 + nota4) / 4

	escreva("A media é: ", media)
	}
}
